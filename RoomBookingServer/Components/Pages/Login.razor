@page "/login"
@attribute [AllowAnonymous]
@layout Layout.MainLayout
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageTitle>Đăng nhập</PageTitle>

<div class="login-page">
    <div class="login-card">
        <h1>Đặt Phòng</h1>
        <p>Đăng nhập bằng tài khoản nhân viên Attendance của bạn.</p>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="login-error">@_error</p>
        }

        <form method="post" action="/auth/login">
            <label for="employeeId">Mã nhân viên</label>
            <input id="employeeId" name="employeeId" required maxlength="10" />

            <label for="password">Mật khẩu</label>
            <input id="password" name="password" type="password" required />

            <button type="submit">Đăng nhập</button>
        </form>
    </div>
</div>

@code {
    private string? _error;

    protected override void OnInitialized()
    {
        var absoluteUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(absoluteUri.Query).TryGetValue("error", out var errorCode))
        {
            return;
        }

        _error = errorCode.ToString() switch
        {
            "invalid" => "Mã nhân viên hoặc mật khẩu không đúng.",
            "missing" => "Vui lòng nhập mã nhân viên và mật khẩu.",
            _ => "Đăng nhập thất bại."
        };
    }
}
