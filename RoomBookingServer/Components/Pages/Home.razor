@page "/"
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using RoomBookingServer.Models.Db.Roombooking
@inject IDbContextFactory<RoombookingContext> RoomDbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Room Booking</PageTitle>

<div class="booking-page">
    <header class="top-bar">
        <div class="brand-panel">
            <img class="brand-logo" src="/header.svg" alt="Interlink Room Booking" />
        </div>
        <div class="top-bar-main">
            <section class="toolbar">
                <button class="icon-button" @onclick="PreviousWeek">
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                    <span>Previous week</span>
                </button>
                <button class="icon-button" @onclick="GoToCurrentWeek">
                    <span class="material-symbols-outlined" aria-hidden="true">today</span>
                    <span>Current week</span>
                </button>
                <button class="icon-button" @onclick="NextWeek">
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    <span>Next week</span>
                </button>
                <strong class="week-label"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>Week of @_weekStart.ToString("dd/MM/yyyy")</strong>
                <button class="primary icon-button" @onclick="OpenNewMeeting">
                    <span class="material-symbols-outlined" aria-hidden="true">add_circle</span>
                    <span>Add meeting</span>
                </button>
            </section>
        </div>
        <div class="user-panel">
            <div class="employee-summary">
                <span class="employee-name">@_displayName</span>
                @if (_isAdmin)
                {
                    <span class="role-pill">Admin</span>
                }
            </div>
            <div class="user-menu">
                <button type="button" class="user-menu-trigger" aria-label="User menu">
                    <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
                </button>
                <div class="user-menu-panel">
                    <a href="/auth/logout" class="logout-link"><span class="material-symbols-outlined" aria-hidden="true">logout</span>Logout</a>
                </div>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="error-banner">@_error</p>
    }

    <table class="calendar-table">
        <thead>
            <tr>
                <th class="timeline-spacer" aria-hidden="true"></th>
                @foreach (var hour in Hours)
                {
                    <th class="hour-header"><span class="hour-header-label">@($"{hour:00}:00")</span></th>
                }
            </tr>
        </thead>
        <tbody>
            @for (var dayOffset = 0; dayOffset < 7; dayOffset++)
            {
                var date = _weekStart.AddDays(dayOffset);
                for (var laneIndex = 0; laneIndex < Rooms.Length; laneIndex++)
                {
                    var room = Rooms[laneIndex];
                    <tr class="@GetLaneRowClass(laneIndex)">
                        @if (laneIndex == 0)
                        {
                            <td class="day-cell" rowspan="3">
                                @date.ToString("dddd", CultureInfo.InvariantCulture)<br />
                                <span>@date.ToString("dd/MM/yyyy")</span>
                            </td>
                        }

                        <td class="schedule-lane" colspan="@Hours.Length">
                            <div class="hour-grid">
                                <span class="lane-label">R@room</span>
                                @for (var hourIndex = 1; hourIndex < Hours.Length; hourIndex++)
                                {
                                    <span class="hour-divider" style="@($"left: {(hourIndex * 100d / Hours.Length):F4}%")"></span>
                                }
                                @foreach (var booking in GetBookingsForLane(date, room))
                                {
                                    <button type="button"
                                            class="meeting-chip room-@booking.Room state-@booking.State"
                                            style="@GetBookingStyle(booking)"
                                            @onclick="() => OpenBookingDetails(booking)">
                                        @booking.Title
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (_showDetails && _selectedBooking is not null)
{
    <div class="modal-backdrop">
        <div class="modal-card booking-details-card">
            <div style="height: 2rem;"></div>
            <h2 class="details-title">
                Meeting
                <span class="details-accent-red">@_selectedBooking.Title</span>
            </h2>
            <p class="details-paragraph">
                This meeting @MeetingTense(_selectedBooking) in room
                <span class="details-accent-blue">R@_selectedBooking.Room</span>
                on
                <span class="details-accent-red">@_selectedBooking.Date.ToString("dddd, dd/MM/yyyy", CultureInfo.InvariantCulture)</span>
                from
                <span class="details-accent-blue">@_selectedBooking.StartTime.ToString("HH:mm")</span>
                to
                <span class="details-accent-blue">@_selectedBooking.EndTime.ToString("HH:mm")</span>.
            </p>
            <hr class="details-divider" />
            <p class="details-paragraph">
                This booking was created by
                <span class="details-accent-red">@_selectedBooking.Creator</span>
                (<span class="details-accent-red">@_selectedBooking.Name</span>).
            </p>
            <p class="details-paragraph">
                Status:
                <span class="details-status-text">@StateText(_selectedBooking.State)</span>
            </p>
            @if (_selectedBooking.State == Booking.ConfirmationWait)
            {
                <p class="details-pending">This booking is waiting for confirmation.</p>
            }
            @if (!string.IsNullOrWhiteSpace(_selectedBooking.Note))
            {
                <p class="details-note-title"><strong>Note:</strong></p>
                <blockquote class="details-note-content">@_selectedBooking.Note</blockquote>
            }
            else
            {
                <p class="details-note-title"><strong>No note.</strong></p>
            }

            <div class="modal-actions">
                @if (CanEdit(_selectedBooking))
                {
                    <button class="icon-button" @onclick="OpenEditMeeting"><span class="material-symbols-outlined" aria-hidden="true">edit</span><span>Edit</span></button>
                }
                @if (CanDelete(_selectedBooking))
                {
                    <button class="danger icon-button" @onclick="DeleteSelectedMeeting"><span class="material-symbols-outlined" aria-hidden="true">delete</span><span>Delete</span></button>
                }
                @if (CanConfirm(_selectedBooking))
                {
                    <button class="primary icon-button" @onclick="ConfirmSelectedMeeting"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span><span>Confirm</span></button>
                }
                <button class="icon-button" @onclick="CloseDetails"><span class="material-symbols-outlined" aria-hidden="true">close</span><span>Close</span></button>
            </div>
        </div>
    </div>
}

@if (_showEditor)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <h2>@(_editor.RoomBookingId.HasValue ? "Edit meeting" : "Add meeting")</h2>

            <label>Title</label>
            <input @bind="_editor.Title" />

            <label>Date</label>
            <input type="date" value="@_editor.DateText" @onchange="e => _editor.DateText = e.Value?.ToString() ?? string.Empty" />

            <label>Room</label>
            <select @bind="_editor.Room">
                <option value="@Room1">@RoomLabels[Room1]</option>
                <option value="@Room2">@RoomLabels[Room2]</option>
                <option value="@Room3">@RoomLabels[Room3]</option>
            </select>

            <label>Start</label>
            <input type="time" step="60" value="@_editor.StartTimeText" @onchange="e => _editor.StartTimeText = e.Value?.ToString() ?? string.Empty" />

            <label>End</label>
            <input type="time" step="60" value="@_editor.EndTimeText" @onchange="e => _editor.EndTimeText = e.Value?.ToString() ?? string.Empty" />

            <label>Note</label>
            <textarea rows="3" @bind="_editor.Note"></textarea>

            <div class="modal-actions">
                <button class="primary icon-button" @onclick="SaveMeetingAsync"><span class="material-symbols-outlined" aria-hidden="true">save</span><span>Save</span></button>
                <button class="icon-button" @onclick="CloseEditor"><span class="material-symbols-outlined" aria-hidden="true">close</span><span>Cancel</span></button>
            </div>
        </div>
    </div>
}

@code {
    private const int Room1 = 1;
    private const int Room2 = 2;
    private const int Room3 = 3;
    private static readonly int[] Rooms = [Room1, Room2, Room3];
    private const int CalendarStartHour = 7;
    private const int CalendarHourCount = 14;
    private static readonly IReadOnlyDictionary<int, string> RoomLabels = new Dictionary<int, string>
    {
        [Room1] = "R1 (confirmation required)",
        [Room2] = "R2",
        [Room3] = "R3"
    };
    private static readonly int[] Hours = Enumerable.Range(CalendarStartHour, CalendarHourCount).ToArray();

    private DateOnly _weekStart = StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
    private List<Booking> _bookings = [];
    private Booking? _selectedBooking;
    private string _employeeId = string.Empty;
    private string _displayName = string.Empty;
    private bool _isAdmin;
    private string? _error;

    private bool _showDetails;
    private bool _showEditor;
    private MeetingEditorModel _editor = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        _employeeId = user.FindFirstValue("employee_id") ?? user.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        _displayName = user.FindFirstValue(ClaimTypes.Name) ?? _employeeId;
        _isAdmin = user.IsInRole("Admin");

        await LoadWeekAsync();
    }

    private async Task LoadWeekAsync()
    {
        await using var db = await RoomDbFactory.CreateDbContextAsync();
        var end = _weekStart.AddDays(6);

        _bookings = await db.Bookings
            .Where(b => b.Date >= _weekStart && b.Date <= end)
            .OrderBy(b => b.Date)
            .ThenBy(b => b.StartTime)
            .ToListAsync();
    }

    private static DateOnly StartOfWeek(DateOnly date)
    {
        var offset = date.DayOfWeek switch
        {
            DayOfWeek.Sunday => -6,
            _ => 1 - (int)date.DayOfWeek
        };

        return date.AddDays(offset);
    }

    private IEnumerable<Booking> GetBookingsForLane(DateOnly date, int room)
    {
        return _bookings
            .Where(b => b.Date == date && b.Room == room)
            .OrderBy(b => b.StartTime);
    }

    private string GetLaneRowClass(int laneIndex) => laneIndex switch
    {
        0 => "day-row day-row-top",
        1 => "day-row day-row-middle",
        _ => "day-row day-row-bottom"
    };

    private void OpenBookingDetails(Booking booking)
    {
        _error = null;
        _selectedBooking = booking;
        _showDetails = true;
    }

    private static string GetBookingStyle(Booking booking)
    {
        var totalMinutes = CalendarHourCount * 60d;
        var startMinutes = Math.Clamp(((booking.StartTime.Hour - CalendarStartHour) * 60d) + booking.StartTime.Minute, 0d, totalMinutes);
        var endMinutes = Math.Clamp(((booking.EndTime.Hour - CalendarStartHour) * 60d) + booking.EndTime.Minute, 0d, totalMinutes);

        if (endMinutes <= startMinutes)
        {
            endMinutes = Math.Min(startMinutes + 1d, totalMinutes);
        }

        var leftPercent = startMinutes * 100d / totalMinutes;
        var widthPercent = (endMinutes - startMinutes) * 100d / totalMinutes;
        return $"left: {leftPercent:F4}%; width: {widthPercent:F4}%;";
    }

    private void OpenNewMeeting()
    {
        _error = null;
        _editor = MeetingEditorModel.CreateNew(_weekStart);
        _showEditor = true;
    }

    private void OpenEditMeeting()
    {
        if (_selectedBooking is null || !CanEdit(_selectedBooking))
        {
            return;
        }

        _error = null;
        _editor = MeetingEditorModel.FromBooking(_selectedBooking);
        _showDetails = false;
        _showEditor = true;
    }

    private async Task SaveMeetingAsync()
    {
        _error = null;

        if (!DateOnly.TryParse(_editor.DateText, out var date))
        {
            _error = "Invalid date.";
            return;
        }

        if (!TimeOnly.TryParse(_editor.StartTimeText, out var startTime) || !TimeOnly.TryParse(_editor.EndTimeText, out var endTime))
        {
            _error = "Invalid time.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editor.Title))
        {
            _error = "Title is required.";
            return;
        }

        if (startTime >= endTime)
        {
            _error = "Start time must be before end time.";
            return;
        }

        if (_editor.Room is < Room1 or > Room3)
        {
            _error = "Room is invalid.";
            return;
        }

        await using var db = await RoomDbFactory.CreateDbContextAsync();

        var overlapQuery = db.Bookings.Where(b =>
            b.Date == date &&
            b.Room == _editor.Room &&
            b.StartTime < endTime &&
            startTime < b.EndTime);

        if (_editor.RoomBookingId.HasValue)
        {
            overlapQuery = overlapQuery.Where(b => b.RoomBookingId != _editor.RoomBookingId.Value);
        }

        if (await overlapQuery.AnyAsync())
        {
            _error = "Booking overlaps with an existing meeting.";
            return;
        }

        Booking booking;
        if (_editor.RoomBookingId.HasValue)
        {
            booking = await db.Bookings.FirstOrDefaultAsync(b => b.RoomBookingId == _editor.RoomBookingId.Value)
                      ?? throw new InvalidOperationException("Booking not found.");

            if (!CanEdit(booking))
            {
                _error = "Only the creator can edit this meeting.";
                return;
            }
        }
        else
        {
            booking = new Booking
            {
                Creator = _employeeId,
                Name = _displayName
            };
            db.Bookings.Add(booking);
        }

        booking.Title = _editor.Title.Trim();
        booking.Date = date;
        booking.Room = _editor.Room;
        booking.StartTime = startTime;
        booking.EndTime = endTime;
        booking.Note = string.IsNullOrWhiteSpace(_editor.Note) ? null : _editor.Note.Trim();
        booking.State = booking.Room == Room1 ? Booking.ConfirmationWait : Booking.Booked;

        await db.SaveChangesAsync();

        _showEditor = false;
        await LoadWeekAsync();
    }

    private async Task DeleteSelectedMeeting()
    {
        if (_selectedBooking is null || !CanDelete(_selectedBooking))
        {
            _error = "You are not allowed to delete this meeting.";
            return;
        }

        await using var db = await RoomDbFactory.CreateDbContextAsync();
        var booking = await db.Bookings.FirstOrDefaultAsync(b => b.RoomBookingId == _selectedBooking.RoomBookingId);
        if (booking is null)
        {
            _error = "Meeting not found.";
            return;
        }

        db.Bookings.Remove(booking);
        await db.SaveChangesAsync();

        _showDetails = false;
        _selectedBooking = null;
        await LoadWeekAsync();
    }

    private async Task ConfirmSelectedMeeting()
    {
        if (_selectedBooking is null || !CanConfirm(_selectedBooking))
        {
            _error = "Only admins can confirm room 1 meetings that are waiting for confirmation.";
            return;
        }

        await using var db = await RoomDbFactory.CreateDbContextAsync();
        var booking = await db.Bookings.FirstOrDefaultAsync(b => b.RoomBookingId == _selectedBooking.RoomBookingId);
        if (booking is null)
        {
            _error = "Meeting not found.";
            return;
        }

        if (booking.Room != Room1 || booking.State != Booking.ConfirmationWait)
        {
            _error = "Meeting is not waiting for confirmation.";
            return;
        }

        booking.State = Booking.Booked;
        await db.SaveChangesAsync();

        _showDetails = false;
        _selectedBooking = null;
        await LoadWeekAsync();
    }

    private bool CanEdit(Booking booking) => string.Equals(booking.Creator, _employeeId, StringComparison.OrdinalIgnoreCase);

    private bool CanDelete(Booking booking) => CanEdit(booking) || _isAdmin;

    private bool CanConfirm(Booking booking) => _isAdmin && booking.Room == Room1 && booking.State == Booking.ConfirmationWait;

    private void CloseDetails() => _showDetails = false;

    private void CloseEditor() => _showEditor = false;

    private async Task PreviousWeek()
    {
        _weekStart = _weekStart.AddDays(-7);
        await LoadWeekAsync();
    }

    private async Task NextWeek()
    {
        _weekStart = _weekStart.AddDays(7);
        await LoadWeekAsync();
    }

    private static string MeetingTense(Booking booking)
    {
        var now = TimeProvider.System.GetLocalNow().DateTime;
        var today = DateOnly.FromDateTime(now);
        var currentTime = TimeOnly.FromDateTime(now);

        if (today < booking.Date || (today == booking.Date && currentTime < booking.StartTime))
        {
            return "will take place";
        }

        if (today == booking.Date && currentTime <= booking.EndTime)
        {
            return "is taking place";
        }

        return "took place";
    }

    private async Task GoToCurrentWeek()
    {
        _weekStart = StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
        await LoadWeekAsync();
    }

    private static string StateText(int state) => state switch
    {
        Booking.Booked => "Booked",
        Booking.ConfirmationWait => "Waiting for confirmation",
        Booking.Unused => "Unused",
        Booking.ConfirmationRejected => "Rejected",
        Booking.Cancelled => "Cancelled",
        _ => $"Unknown ({state})"
    };

    private sealed class MeetingEditorModel
    {
        public int? RoomBookingId { get; set; }
        public string Title { get; set; } = string.Empty;
        public int Room { get; set; } = 2;
        public string DateText { get; set; } = string.Empty;
        public string StartTimeText { get; set; } = "08:00";
        public string EndTimeText { get; set; } = "09:00";
        public string? Note { get; set; }

        public static MeetingEditorModel CreateNew(DateOnly weekStart)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var target = weekStart < today ? today : weekStart;
            return new MeetingEditorModel
            {
                DateText = target.ToString("yyyy-MM-dd")
            };
        }

        public static MeetingEditorModel FromBooking(Booking booking)
        {
            return new MeetingEditorModel
            {
                RoomBookingId = booking.RoomBookingId,
                Title = booking.Title,
                Room = booking.Room,
                DateText = booking.Date.ToString("yyyy-MM-dd"),
                StartTimeText = booking.StartTime.ToString("HH:mm"),
                EndTimeText = booking.EndTime.ToString("HH:mm"),
                Note = booking.Note
            };
        }
    }
}
