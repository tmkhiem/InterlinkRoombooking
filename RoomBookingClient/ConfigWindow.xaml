<Window x:Class="RoomBookingClient.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Booking Client Config"
        Width="420"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" Text="Server URL" />
        <TextBox x:Name="ServerUrlTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" Text="Room number" />
        <TextBox x:Name="RoomNumberTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" Text="API key" />
        <TextBox x:Name="ApiKeyTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="DimGray" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestWarningButton" Width="110" Margin="0,0,8,0" Content="Test warning" Click="TestWarningButton_Click" />
            <Button x:Name="RefreshButton" Width="100" Margin="0,0,8,0" Content="Refresh now" Click="RefreshButton_Click" />
            <Button x:Name="SaveButton" Width="80" Content="Save" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
