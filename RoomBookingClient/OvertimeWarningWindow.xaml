<Window x:Class="RoomBookingClient.OvertimeWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cảnh báo quá giờ họp"
        Width="420"
        Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Text="Cuộc họp đã vượt quá thời lượng được cấp." />

        <Button Grid.Row="1"
                Width="90"
                Height="30"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Content="Đóng"
                Click="CloseButton_Click" />
    </Grid>
</Window>
